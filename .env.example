# Every variable below is read via ${VAR} or ${VAR:default} in
# backend/src/main/resources/application.properties. Copy this file to
# backend/.env (or export these as real environment variables) and fill
# in real values — never commit the real file.

# ── Database ─────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/workflow_engine
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=2

# ── Server ───────────────────────────────────────────────────────────────
PORT=8080

# ── Mail (spring.mail.host is hardcoded to smtp.gmail.com in application.properties) ──
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ── Bootstrap key issuance ───────────────────────────────────────────────
# Required for POST /api/v1/keys/issue (X-Bootstrap-Secret header).
# If left blank, that endpoint fails closed per the code in
# ApiKeyManagementController.
APP_BOOTSTRAP_SECRET=

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SHOW_SQL=false
SQL_LOG_LEVEL=WARN

# ── Async executor ───────────────────────────────────────────────────────
ASYNC_CORE_POOL_SIZE=4
ASYNC_MAX_POOL_SIZE=20
ASYNC_QUEUE_CAPACITY=500
ASYNC_KEEP_ALIVE_SECONDS=60

# =============================================================================
# Frontend (frontend/.env.local — read in frontend/src/services/api.js)
# =============================================================================
# VITE_API_URL=http://localhost:8080/api/v1
# VITE_API_KEY=          # raw key returned from POST /api/v1/keys/issue
