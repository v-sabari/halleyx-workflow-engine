# =============================================================================
# Halleyx Workflow Engine — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env.production to version control.
#
# In CI/CD (Vercel, Netlify, Railway, etc.) set these as environment
# variables in the platform dashboard — do NOT put them in committed files.
# =============================================================================

# ── Backend API base URL ──────────────────────────────────────────────────────
# Must end with /api/v1 (no trailing slash).
# Development default is already set in api.js as a fallback, but explicit is
# better so Vite can tree-shake correctly.
VITE_API_URL=http://localhost:8080/api/v1

# ── API Key (REQUIRED once Spring Security is active on the backend) ──────────
# Obtain a key by calling:
#   POST http://localhost:8080/api/v1/keys/issue
#   Body: { "description": "frontend-dev" }
# Copy the "rawKey" from the response into this variable.
# IMPORTANT: This key is embedded in the compiled JS bundle — it is NOT a
# server secret. Treat it as a "public client key" scoped only to the
# permissions your frontend needs. Rotate it if it leaks.
VITE_API_KEY=replace_with_your_raw_key_from_POST_api_v1_keys_issue
